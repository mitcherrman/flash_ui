# Copy to .env.local (gitignored) to override the backend URL for local dev.
# Expo inlines EXPO_PUBLIC_* values into the JS bundle at build time, so they
# are PUBLIC: never put secrets here.
#
# Server origin only (no trailing /api/flashcards). Applies to web AND native.
# Leave unset to use the defaults:
#   web    -> http://127.0.0.1:8000
#   native -> http://<LAN IP of the Expo dev host>:8000
# EXPO_PUBLIC_API_BASE=http://192.168.0.42:8000

# Show developer-only controls (Picker cache-clear buttons, raw template JSON).
# Hidden unless set to 1.
# EXPO_PUBLIC_SHOW_DEV_TOOLS=1

# The offline portfolio demo is built with EXPO_PUBLIC_FLASH_DEMO=1, but only
# through `npm run export:demo`. Don't set it in an env file: every start and
# export would then run the demo instead of the app.
